<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hri_audio</name>
  <version>0.0.1</version>
  <description>Nodo de captura de audio: publica hri_interfaces/AudioChunk en /audio/raw</description>
  <maintainer email="constansalazar@gmail.com">alb3r7g12</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>hri_interfaces</depend>

  <!-- sounddevice se instala por pip en el Dockerfile: no tiene clave de rosdep. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
