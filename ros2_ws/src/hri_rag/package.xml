<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hri_rag</name>
  <version>0.0.1</version>
  <description>Ingesta y consulta de documentos privados con embeddings locales e indice vectorial por persona.</description>
  <maintainer email="constansalazar@gmail.com">Albert Constantino Salazar</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>hri_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
